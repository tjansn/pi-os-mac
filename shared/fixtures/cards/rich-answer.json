{
  "format": "pi-os-ui/1",
  "root": "root",
  "elements": {
    "root": {
      "type": "Answer",
      "props": {
        "summary": "Flight options compared"
      },
      "children": [
        "n1",
        "n2",
        "n3",
        "n4",
        "n5",
        "n6"
      ]
    },
    "n1": {
      "type": "Markdown",
      "props": {
        "source": "Here are the **two** cheapest options I found on the page."
      }
    },
    "n2": {
      "type": "KeyValue",
      "props": {
        "title": "Best option",
        "items": [
          {
            "key": "Airline",
            "value": "Lufthansa"
          },
          {
            "key": "Price",
            "value": "€214"
          }
        ]
      }
    },
    "n3": {
      "type": "Table",
      "props": {
        "title": "All options",
        "columns": [
          {
            "key": "airline",
            "label": "Airline"
          },
          {
            "key": "price",
            "label": "Price",
            "align": "right"
          },
          {
            "key": "stops",
            "label": "Stops",
            "align": "right"
          }
        ],
        "rows": [
          {
            "airline": "Lufthansa",
            "price": "€214",
            "stops": 0
          },
          {
            "airline": "Eurowings",
            "price": "€189",
            "stops": 1
          }
        ]
      }
    },
    "n4": {
      "type": "Status",
      "props": {
        "state": "done",
        "text": "Compared 2 results",
        "progress": 1
      }
    },
    "n5": {
      "type": "Suggestion",
      "props": {
        "prompt": "Book the Lufthansa flight"
      },
      "on": {
        "press": {
          "action": "askAgent",
          "params": {
            "prompt": "Book the Lufthansa flight"
          }
        }
      }
    },
    "n6": {
      "type": "Item",
      "props": {
        "title": "lufthansa.com",
        "subtitle": "https://www.lufthansa.com/de/en/homepage",
        "icon": {
          "kind": "url"
        }
      },
      "on": {
        "primary": {
          "action": "openURL",
          "params": {
            "url": "https://www.lufthansa.com/de/en/homepage"
          }
        },
        "secondary": {
          "action": "copyText",
          "params": {
            "text": "https://www.lufthansa.com/de/en/homepage"
          }
        }
      }
    }
  }
}
