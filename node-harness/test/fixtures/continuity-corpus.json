{
 "version": 1,
 "about": "Continuity corpus (DESIGN5 §5.4 with Tom's binding answers of 2026-10-08): synthetic EN/DE/mixed takes, each with a class that fixes what an eligible focused field receives. dictation, explicit, explicit-held and search are must-fill (into the kinds that allow it); every other class is must-not-fill. Text fixtures only: no user content.",
 "classes": {
  "dictation": "must fill: plain phrases, questions and sentences. search, address, text and multiline get the text (Return only in search boxes and the address bar); a terminal gets the one-Return offer; credential and sensitive fields get nothing (no check card, no hints); confirm and rename keep today's decision",
  "command": "must not fill: an instant command decides exactly as without a target (one that misses is never typed)",
  "page": "must not fill: page and window questions stay with pi",
  "task": "must not fill: pi tasks with a task head or addressed to pi, UI commands",
  "deletion": "must not fill: deletion requests stay refused, deletion words never reach a field on their own",
  "control": "must not fill: the bar's own answers, cancel and submit words",
  "correction": "must not fill: corrections addressed to pi-os",
  "pi": "must not fill: the escape to pi",
  "explicit": "must fill: the remainder of tippe/type/diktiere/gib … ein into every kind but confirm (refused) and rename (today's decision)",
  "explicit-held": "must fill after one Return: deletion words in an explicit remainder, never submitted",
  "explicit-refused": "must not fill: a remainder that is itself a deletion request is refused",
  "search": "must fill: the query of a bare search form into a search box or a browser's address bar with one Return; a browser without one opens the web search"
 },
